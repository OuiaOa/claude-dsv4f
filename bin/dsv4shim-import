#!/usr/bin/env node
/**
 * dsv4shim-import — bring your existing Claude Code state into the dsv4shim profile.
 *
 * Copies memories, per-project session transcripts, permissions and any agents/skills/commands
 * from ~/.claude into ~/.dsv4shim, so `dsv4shim` in a project directory sees the same
 * history and can --resume it.
 *
 * Transcripts are SANITISED on the way in, and that is the part that makes resume actually work
 * rather than 400 on the first turn. Anthropic assistant turns carry thinking blocks with
 * cryptographic signatures that DeepSeek cannot validate, plus image blocks its endpoint does
 * not accept at all. Copying them verbatim produces a conversation that cannot be replayed. So:
 *   - thinking / redacted_thinking blocks are dropped, and any `signature` field with them
 *   - image and document blocks become a short text placeholder
 *   - cache_control markers are stripped (DeepSeek ignores them; they only bloat the body)
 *
 * The walk is recursive. Each Claude Code project directory contains:
 *   - <uuid>.jsonl             — main session transcript (scrubbed)
 *   - <uuid>/subagents/*.jsonl — subagent transcripts (also scrubbed)
 *   - <uuid>/subagents/*.meta.json
 *   - <uuid>/tool-results/*    — blobs referenced by tool_result blocks (copied verbatim)
 *   - <uuid>/.meta.json
 *   - memory/                  — project-scoped memories
 * The old non-recursive walk silently dropped every nested file, which made subagent
 * sessions invisible to `claude --resume`.
 *
 * Never copies .credentials.json — that is an Anthropic OAuth session and is meaningless here.
 *
 * Usage: dsv4shim-import [--dry-run] [--force] [--auto] [--quiet] [--source <path>]
 *
 *   --source <path>   import from a directory other than ~/.claude
 *                      (if ~/.claude is missing AND stdin is a TTY, you'll be prompted)
 *   --auto            no interactive picker (implies "all"); used by the dsv4shim
 *                      launcher on every run, not just the first
 *   --quiet           print nothing unless something actually changed (one compact line);
 *                      with neither --auto nor --quiet, prints the full itemised report
 *
 * INCREMENTAL BY DEFAULT: a per-file manifest (.import-state.json, mtime+size) means a repeat
 * run only re-scrubs/copies files that are new or have changed since the last run — the whole
 * point being that this is cheap enough to run on every single `dsv4shim` launch, not just
 * once. (Earlier versions gated the whole import behind a one-time .imported marker file, so
 * any Claude Code session created after the very first launch was never picked up again —
 * --force still exists to wipe the manifest and reprocess everything from scratch.)
 */
import fs from 'node:fs';
import path from 'node:path';
import os from 'node:os';

// HOME is injectable for isolated installs/tests. On Windows os.homedir() ignores a
// subprocess-provided HOME, which previously made setup source imports read the real user's
// ~/.claude instead of the selected source fixture.
const HOME = process.env.DSV4SHIM_HOME || process.env.HOME || os.homedir();
const DST = process.env.DSV4SHIM_PROFILE || path.join(HOME, '.dsv4shim');
const MARKER = path.join(DST, '.imported');            // now just "last synced at", not a gate
const STATE_FILE = path.join(DST, '.import-state.json'); // per-file mtime+size manifest

const args = process.argv.slice(2);
const DRY = args.includes('--dry-run');
const FORCE = args.includes('--force');
const AUTO = args.includes('--auto');
const QUIET = args.includes('--quiet');

// --source <path>  (or  --source=<path>)
function argSource() {
  const eq = args.find(a => a.startsWith('--source='));
  if (eq) return eq.slice('--source='.length);
  const i = args.indexOf('--source');
  if (i >= 0 && args[i + 1] && !args[i + 1].startsWith('--')) return args[i + 1];
  return null;
}

const bold = s => `\x1b[1m${s}\x1b[0m`;
const dim = s => `\x1b[2m${s}\x1b[0m`;
const red = s => `\x1b[31m${s}\x1b[0m`;
const die = (m) => { console.error(red(m)); process.exit(1); };

let SRC = argSource() || path.join(HOME, '.claude');
if (!fs.existsSync(SRC)) {
  // Only prompt when the user didn't already specify --source AND there's a real terminal
  // attached. In a sandboxed/automated run we just fail with a clear message.
  const TTY = process.stdin.isTTY && process.stdout.isTTY;
  if (!DRY && TTY && !argSource()) {
    const readline = (await import('node:readline')).default;
    const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
    const ans = await new Promise(res => rl.question(
      `No ~/.claude found at ${SRC}.\nEnter a different path to import from (Enter to abort): `,
      a => { rl.close(); res(a.trim()); }
    ));
    if (!ans) die('Aborted.');
    SRC = path.resolve(ans);
  }
  if (!fs.existsSync(SRC)) die(
    `No source directory at ${SRC}.\n` +
    `  Pass --source <path> to specify one, or run interactively so it can be prompted.`
  );
}

// FORCE means "reprocess everything from scratch" — start from an empty manifest so every
// file looks new. Otherwise load what was recorded last run; a missing/corrupt file just
// means "nothing recorded yet," not an error.
let importState = {};
if (!FORCE) {
  try { importState = JSON.parse(fs.readFileSync(STATE_FILE, 'utf8')); } catch { importState = {}; }
}
const newState = { ...importState };

let copied = 0, sanitised = 0, skipped = 0, skippedUnchanged = 0, thinkingDropped = 0, imagesDropped = 0;
const plan = [];

function note(what, detail) { plan.push(`  ${what.padEnd(34)} ${detail}`); }

/**
 * True when srcFile is new or has changed (mtime or size) since the last recorded run.
 * Always records the current fingerprint into newState regardless of the answer, so a run
 * that touches a file — whether or not it decides to reprocess it — leaves an up-to-date
 * record for next time. Keyed by SRC + relative path so switching --source can never collide
 * with a manifest entry recorded against a different source tree.
 */
function needsProcessing(srcFile, relKey) {
  let st;
  try { st = fs.statSync(srcFile); } catch { return true; }
  const key = `${SRC}::${relKey}`;
  const prev = importState[key];
  newState[key] = { mtimeMs: st.mtimeMs, size: st.size };
  return !prev || prev.mtimeMs !== st.mtimeMs || prev.size !== st.size;
}

// ------------------------------------------------------------------ sanitising

/**
 * Anthropic-meta tags embedded in TEXT strings. These are part of how Claude Code's
 * runtime / IDE talks to Claude; they are meaningless to DeepSeek and the Anthropic-shaped
 * prompts that already lost their meaning would just confuse the new model. Removing them
 * keeps the conversation flow intact without dragging Anthropic-specific scaffolding along.
 *
 * The match is line-aware: a tag that opens on one line and closes on a later line still
 * matches, because tool results can be very long. The whole region is replaced with a
 * short note so the next model knows something was elided without losing track of position.
 */
const TAG_PATTERNS = [
  // System reminders Claude Code injects into the prompt — none of the context is useful
  // when the runtime is gone and the model is DeepSeek.
  { re: /<system-reminder>[\s\S]*?<\/system-reminder>/g, label: '[system-reminder elided]' },
  // IDE selection snapshots (cursor position, etc.) — stale and Anthropic-specific.
  { re: /<ide_selection>[\s\S]*?<\/ide_selection>/g, label: '[ide_selection elided]' },
  // Skill / tool result envelope markers occasionally appear inline when Claude Code nests a
  // tool call result inside a user message. We treat them the same as the structural block
  // version above.
  { re: /<antml:[a-z_]+>[\s\S]*?<\/antml:[a-z_]+>/g, label: '[antml tag elided]' },
];

/**
 * Patterns for AI-self-descriptions that DeepSeek should not parrot back. These are
 * Anthropic-specific and only ever appear when Claude itself wrote the text; the user
 * almost certainly did not. Strip them so the resumed session does not lead off with "as
 * an AI assistant by Anthropic" or similar nonsense when DeepSeek has no idea what Claude is.
 *
 * Conservative on purpose — only matches the *exact* Claude/Anthropic boilerplate, never
 * the user's own words.
 */
const SELF_DESC_PATTERNS = [
  /\bI'?m Claude(?:,? an AI assistant (?:made|built) by Anthropic)?\.?/gi,
  /\bI am Claude\b[^.]{0,80}\. ?/gi,
  /\bI'?m an AI (?:assistant|model)(?:[^.]{0,80})?(?:made|built|created|trained|developed) by Anthropic\.?/gi,
  /\bI'?m an AI(?:[^.]{0,60})\bby Anthropic\.?/gi,
  /\bI was made by Anthropic\.?/gi,
  /\bI was trained by Anthropic\.?/gi,
];

/**
 * Strips a string of Anthropic-specific scaffolding. Returns the same string with no
 * detectable differences if nothing matches, so it is safe to call unconditionally on every
 * text field.
 */
function scrubText(s) {
  if (typeof s !== 'string' || !s) return s;
  let out = s;
  for (const { re, label } of TAG_PATTERNS) out = out.replace(re, label);
  for (const re of SELF_DESC_PATTERNS) out = out.replace(re, '');
  // Collapse runs of blank lines left by removals; preserves real paragraph breaks.
  out = out.replace(/\n{3,}/g, '\n\n').trim();
  return out;
}

function scrubContent(content) {
  if (!Array.isArray(content)) return content;
  const out = [];
  for (const b of content) {
    if (!b || typeof b !== 'object') { out.push(b); continue; }
    if (b.type === 'thinking' || b.type === 'redacted_thinking') { thinkingDropped++; continue; }
    if (b.type === 'image') {
      imagesDropped++;
      out.push({ type: 'text', text: '[image from a previous session — not carried over]' });
      continue;
    }
    if (b.type === 'document') {
      out.push({ type: 'text', text: '[document from a previous session — not carried over]' });
      continue;
    }
    const c = { ...b };
    delete c.cache_control;
    delete c.signature;
    if (typeof c.text === 'string') c.text = scrubText(c.text);
    if (Array.isArray(c.content)) c.content = scrubContent(c.content);   // tool_result nesting
    out.push(c);
  }
  return out;
}

function scrubTranscript(srcFile, dstFile) {
  const lines = fs.readFileSync(srcFile, 'utf8').split('\n');
  const out = [];
  for (const line of lines) {
    if (!line.startsWith('{')) continue;
    let j;
    try { j = JSON.parse(line); } catch { continue; }
    // Top-level .message is the SDK shape; some Claude Code builds nest into .payload
    // instead. Cover both so we don't miss lines on either format.
    const target = j.message || j.payload?.message;
    if (target?.content) {
      const scrubbed = scrubContent(target.content);
      if (j.message) j.message.content = scrubbed;
      else j.payload.message.content = scrubbed;
    }
    // Also scrub the cached system prompt block if it was inlined into the transcript —
    // happens on a few Claude Code versions and carries the same Anthropic-specific tags.
    if (typeof j.system === 'string') j.system = scrubText(j.system);
    out.push(JSON.stringify(j));
  }
  if (!DRY) {
    fs.mkdirSync(path.dirname(dstFile), { recursive: true });
    fs.writeFileSync(dstFile, out.join('\n') + '\n');
  }
  return out.length;
}

/**
 * Strips Anthropic-specific scaffolding from a memory file's text content. The whole file
 * is read, scrubbed, and rewritten. Unlike transcripts, memory files are usually user-written
 * markdown so we keep this conservative: only tag regions and the AI-self-description
 * patterns above are touched. Everything else is preserved exactly.
 */
function scrubMemoryFile(srcFile, dstFile) {
  let raw;
  try { raw = fs.readFileSync(srcFile, 'utf8'); }
  catch { return false; }
  const cleaned = scrubText(raw);
  if (cleaned === raw) return false;   // no change — skip the write to keep mtime stable
  if (!DRY) {
    fs.mkdirSync(path.dirname(dstFile), { recursive: true });
    fs.writeFileSync(dstFile, cleaned);
  }
  return true;
}

// -------------------------------------------------------------------- recursive walk
//
// Walks `from` recursively, writing to the same relative path under `to`.
//   - .jsonl files are scrubbed (thinking blocks / images / signatures stripped)
//   - everything else is copied verbatim (PDFs, .meta.json, etc. — these are referenced
//     from .jsonl entries and must be byte-identical for Claude Code to load them)
// Returns { files, jsonls, changedFiles, changedJsonls } ACROSS THE WHOLE TREE (recursive).
// files/jsonls count everything SEEN (present at the source, whether reprocessed or skipped
// as unchanged); changedFiles/changedJsonls count only what was ACTUALLY (re)written this
// run — that split is what lets a repeat run report "nothing new" truthfully instead of
// re-claiming credit for files a previous run already brought over.

function walkTree(from, to, rel = '') {
  let entries;
  try { entries = fs.readdirSync(from, { withFileTypes: true }); }
  catch { return { files: 0, jsonls: 0, changedFiles: 0, changedJsonls: 0 }; }   // unreadable dir — skip silently
  let files = 0, jsonls = 0, changedFiles = 0, changedJsonls = 0;
  const inMemory = rel.split(path.sep).includes('memory') || from.endsWith(`${path.sep}memory`);
  for (const e of entries) {
    const s = path.join(from, e.name);
    const d = path.join(to, e.name);
    const childRel = rel ? path.join(rel, e.name) : e.name;
    if (e.isDirectory()) {
      if (!DRY) fs.mkdirSync(d, { recursive: true });
      const sub = walkTree(s, d, childRel);
      files += sub.files; jsonls += sub.jsonls;
      changedFiles += sub.changedFiles; changedJsonls += sub.changedJsonls;
      continue;
    }
    const changed = needsProcessing(s, childRel);
    if (!changed) skippedUnchanged++;

    if (e.name.endsWith('.jsonl')) {
      jsonls++;
      if (changed) {
        if (scrubTranscript(s, d) === 0) note(`transcript ${e.name.slice(0, 8)}`, 'empty after scrub');
        changedJsonls++; sanitised++;
      }
    } else {
      files++;
      if (changed) {
        // .md files inside a memory/ subtree are scanned for Anthropic-specific tags
        // (system-reminder, "I am Claude", etc.). The text is otherwise preserved verbatim
        // — we never rewrite user-written markdown otherwise. Other files (PDFs, .meta.json)
        // are copied byte-identical: Claude Code's tool_result blocks reference them by hash.
        if (e.name.endsWith('.md') && inMemory) {
          if (!scrubMemoryFile(s, d) && !DRY) { fs.mkdirSync(path.dirname(d), { recursive: true }); fs.copyFileSync(s, d); }
        } else if (!DRY) {
          fs.mkdirSync(path.dirname(d), { recursive: true }); fs.copyFileSync(s, d);
        }
        changedFiles++;
      }
    }
  }
  copied += changedFiles + changedJsonls;
  return { files, jsonls, changedFiles, changedJsonls };
}

// AUTO mode (the launcher's every-launch sync) stays silent up front — whether anything is
// worth printing at all is only known once the whole walk is done, and most runs find
// nothing new. See the final QUIET/AUTO-aware summary block at the bottom.
if (!AUTO) {
  console.log(bold(`\ndsv4shim import${DRY ? ' (dry run — nothing written)' : ''}\n`));
  console.log(`  from ${SRC}\n  to   ${DST}\n`);
}

// 1. per-project trees: <SRC>/projects/<proj>/  →  <DST>/projects/<proj>/
//
// Interactive selection (only when stderr is a TTY and no explicit selection was given):
// the user can type "all", "none", "1,3,5", "2-4", or hit Enter to accept the default
// (all). Non-interactive runs (CI, piped input) default to all so existing behaviour
// and scripts keep working unchanged.

const projSrc = path.join(SRC, 'projects');
let selectedProjects = null;   // null = no source dir / no interactive picker; Set = explicit choice

if (fs.existsSync(projSrc)) {
  const allProjects = fs.readdirSync(projSrc)
    .filter(p => !p.includes('dsv4shim'));   // never import this profile into itself

  if (allProjects.length === 0) {
    console.log(dim('  (no projects found in source)'));
  } else if (args.includes('--all')) {
    selectedProjects = new Set(allProjects);
  } else if (args.includes('--none')) {
    selectedProjects = new Set();
  } else if (!DRY && !FORCE && !AUTO && process.stdin.isTTY && process.stdout.isTTY) {
    // First-run picker: only when the user didn't force --all/--none/--auto and there's no
    // marker. We deliberately skip the picker on --force (re-import) so users re-running
    // don't have to confirm every time, and --auto never shows it at all (it's meant to run
    // unattended on every launch).
    selectedProjects = await pickProjects(allProjects);
  }

  const toWalk = selectedProjects
    ? allProjects.filter(p => selectedProjects.has(p))
    : allProjects;

  if (selectedProjects) {
    const skippedByChoice = allProjects.length - toWalk.length;
    if (skippedByChoice) note('selection', `skipped ${skippedByChoice} project${skippedByChoice === 1 ? '' : 's'} by user choice`);
  }

  for (const proj of toWalk) {
    const from = path.join(projSrc, proj), to = path.join(DST, 'projects', proj);
    if (!DRY) fs.mkdirSync(to, { recursive: true });
    const { changedJsonls } = walkTree(from, to);
    if (changedJsonls) note(`sessions: ${proj.slice(0, 24)}`, `${changedJsonls} transcript${changedJsonls === 1 ? '' : 's'}`);
  }
  skipped += allProjects.length - toWalk.length;
}

// Ask the user which source projects to import. Returns a Set of names, or `null` for
// "import none" (the user typed `none` / empty after a previous run was aborted).
async function pickProjects(projects) {
  const readline = (await import('node:readline')).default;
  console.log(bold('\nProjects found in source:'));
  // Show a short, readable label for each project (decoded-path form) so the user can
  // pick by something more meaningful than the encoded-path folder name.
  projects.forEach((p, i) => {
    const decoded = p.replace(/--/g, ' / ').replace(/^-|-$/g, '') || '(root)';
    const meta = (() => {
      try {
        const st = fs.statSync(path.join(projSrc, p));
        const jsonls = (() => {
          let n = 0;
          const walk = (d) => { for (const e of fs.readdirSync(d, { withFileTypes: true })) {
            const s = path.join(d, e.name);
            if (e.isDirectory()) walk(s);
            else if (e.name.endsWith('.jsonl')) n++;
          } };
          try { walk(path.join(projSrc, p)); } catch {}
          return n;
        })();
        const mtime = st.mtime.toISOString().slice(0, 10);
        return `(${jsonls} transcript${jsonls === 1 ? '' : 's'}, last touched ${mtime})`;
      } catch { return ''; }
    })();
    console.log(`  ${grn(String(i + 1).padStart(3))}. ${decoded}  ${dim(meta)}`);
  });
  console.log(dim(`\nTotal: ${projects.length} project${projects.length === 1 ? '' : 's'}`));

  const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
  const ask = (q) => new Promise(res => rl.question(q, a => { res(a.trim()); }));
  while (true) {
    const ans = await ask('\nImport which? [all / none / 1,3,5 / 2-4] (Enter = all): ');
    if (ans === '' || /^all$/i.test(ans)) { rl.close(); return new Set(projects); }
    if (/^none$/i.test(ans) || ans === '0') { rl.close(); return new Set(); }
    const set = new Set();
    let bad = false;
    for (const part of ans.split(',').map(s => s.trim()).filter(Boolean)) {
      const m = part.match(/^(\d+)(?:\s*-\s*(\d+))?$/);
      if (!m) { bad = true; break; }
      const a = parseInt(m[1], 10), b = m[2] ? parseInt(m[2], 10) : a;
      if (a < 1 || b > projects.length || a > b) { bad = true; break; }
      for (let i = a; i <= b; i++) set.add(projects[i - 1]);
    }
    if (bad) { console.log(yel('  Unrecognised — try: all / none / 1,3 / 2-4')); continue; }
    rl.close();
    return set;
  }
}

function grn(s) { return `\x1b[32m${s}\x1b[0m`; }
function yel(s) { return `\x1b[33m${s}\x1b[0m`; }

// 2. portable config — agents, skills, commands, output styles, user CLAUDE.md
for (const d of ['agents', 'skills', 'commands', 'output-styles']) {
  const from = path.join(SRC, d);
  if (!fs.existsSync(from)) continue;
  const to = path.join(DST, d);
  if (!DRY) fs.mkdirSync(to, { recursive: true });
  const { changedFiles } = walkTree(from, to);
  if (changedFiles) note(d, `${changedFiles} file${changedFiles === 1 ? '' : 's'}`);
}
const userMd = path.join(SRC, 'CLAUDE.md');
if (fs.existsSync(userMd)) {
  if (needsProcessing(userMd, 'CLAUDE.md')) {
    if (!DRY) fs.copyFileSync(userMd, path.join(DST, 'CLAUDE.md'));
    note('CLAUDE.md', 'user-level instructions'); copied++;
  } else {
    skippedUnchanged++;
  }
}

// 3. permissions — merged, never overwriting the env block that IS the integration
const srcSettings = (() => { try { return JSON.parse(fs.readFileSync(path.join(SRC, 'settings.json'), 'utf8')); } catch { return null; } })();
const dstPath = path.join(DST, 'settings.json');
const dstSettings = (() => { try { return JSON.parse(fs.readFileSync(dstPath, 'utf8')); } catch { return null; } })();
if (srcSettings?.permissions?.allow && dstSettings) {
  const have = new Set(dstSettings.permissions?.allow || []);
  const add = srcSettings.permissions.allow.filter(r => !have.has(r));
  if (add.length) {
    dstSettings.permissions = dstSettings.permissions || {};
    dstSettings.permissions.allow = [...(dstSettings.permissions.allow || []), ...add];
    copied += add.length;
    if (!DRY) { fs.writeFileSync(dstPath, JSON.stringify(dstSettings, null, 2) + '\n'); fs.chmodSync(dstPath, 0o600); }
    note('permissions', `${add.length} rule${add.length === 1 ? '' : 's'} merged`);
  } else note('permissions', 'already up to date');
}

const hadChanges = copied > 0;

if (QUIET) {
  // The whole point of --quiet (used by the launcher on every single run): say nothing when
  // there's nothing new, so a normal launch with no upstream activity since the last one
  // doesn't print anything at all. When something DID change, one compact line beats silence
  // — the user should be able to tell dsv4shim is actually keeping up, not just trust it blindly.
  if (hadChanges) {
    const bits = [];
    if (sanitised) bits.push(`${sanitised} session${sanitised === 1 ? '' : 's'}`);
    const otherFiles = copied - sanitised;
    if (otherFiles > 0) bits.push(`${otherFiles} other item${otherFiles === 1 ? '' : 's'}`);
    console.log(`dsv4shim: synced ${bits.join(', ') || `${copied} item(s)`} from ${SRC}`);
  }
} else {
  console.log(plan.join('\n') || '  (nothing to import)');
  console.log(bold('\nSummary'));
  console.log(`  files copied        : ${copied}`);
  console.log(`  transcripts scrubbed: ${sanitised}`);
  console.log(`  thinking blocks     : ${thinkingDropped} dropped ${dim('(signatures DeepSeek cannot validate)')}`);
  console.log(`  images/documents    : ${imagesDropped} replaced ${dim('(unsupported upstream)')}`);
  if (skippedUnchanged) console.log(`  unchanged           : ${skippedUnchanged} file(s) already synced (no changes since last run)`);
  if (skipped) console.log(`  skipped             : ${skipped} dsv4shim project dir(s)`);
  console.log(dim('\n  .credentials.json was NOT copied — it is an Anthropic session, meaningless here.'));
}

if (!DRY) {
  fs.mkdirSync(DST, { recursive: true });
  fs.writeFileSync(MARKER, new Date().toISOString() + '\n');
  fs.writeFileSync(STATE_FILE, JSON.stringify(newState));
  if (!AUTO) console.log(`\n${bold('Done.')} cd into any project and run: dsv4shim run --resume\n`);
} else {
  console.log(`\n${bold('Dry run.')} Re-run without --dry-run to apply.\n`);
}
